# ── Firebase ──────────────────────────────────────────
# คัดลอกจาก Firebase Console → Project Settings → Service Account → Generate Key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXX\n-----END PRIVATE KEY-----\n"

# ── Gmail ──────────────────────────────────────────────
# ใช้ App Password (ไม่ใช่รหัสผ่านปกติ)
# ไปที่ myaccount.google.com → Security → 2-Step Verification → App passwords
GMAIL_USER=masscom.musicroom@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Admin ──────────────────────────────────────────────
ADMIN_PASSWORD=เปลี่ยนรหัสผ่านนี้ด้วยนะคะ

# ── Frontend URL (สำหรับ CORS) ────────────────────────
FRONTEND_URL=https://your-frontend.vercel.app

# ── Port ───────────────────────────────────────────────
PORT=3001
